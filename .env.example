# Cổng chạy server
PORT=3000

# URL gốc của website (dùng cho link tải trong email)
BASE_URL=https://your-domain.com

# SMTP để gửi email ebook cho khách sau khi thanh toán
# Có thể cấu hình trong Admin > Settings thay vì dùng file .env
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ĐĂNG TRÍ <your-email@gmail.com>
